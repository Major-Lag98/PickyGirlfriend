{
	"name": "pickygirlfriend",
	"main": "worker/index.js",
	"compatibility_date": "2026-05-25",
	// Serve the static site from /public; route the API through the Worker first.
	"assets": {
		"directory": "./docs",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*"
		]
	},
	// Restaurant list storage. Replace "id" with the value printed by:
	//   npx wrangler kv namespace create RESTAURANTS_KV
	"kv_namespaces": [
		{
			"binding": "RESTAURANTS_KV",
			"id": "7c9167350c004724b047d2b0333bb29e"
		}
	],
	"observability": {
		"enabled": true
	}
}